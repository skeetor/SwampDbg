<Window x:Class="TestApplication.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:TestApplication"
	xmlns:DMNS="clr-namespace:WpfDockingManager;assembly=WpfDockingManager"
	xmlns:uc="clr-namespace:TestApplication.Controls"
	mc:Ignorable="d"
	Title="DockingTest" Height="450" Width="800">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0">
			<Menu Name="mnMainMenu" DockPanel.Dock="Top">
				<MenuItem Header="_File">
					<MenuItem Header="_Open">
						<MenuItem Header="_File"/>
						<MenuItem Header="_Project"/>
					</MenuItem>
					<Separator />
					<MenuItem Header="_Exit" />
				</MenuItem>
				<MenuItem Header="_Tools">
					<MenuItem Header="_Configure1" />
					<MenuItem Header="_Configure2" />
				</MenuItem>
				<MenuItem Header="_Plugins">
					<MenuItem Header="_Configure" />
					<MenuItem Header="_Unload" />
				</MenuItem>
				<MenuItem Header="_Help">
					<MenuItem Header="_About" />
				</MenuItem>
			</Menu>
			<ToolBarTray DockPanel.Dock="Top">
				<ToolBar>
					<Button Content="{StaticResource ArrowBlueLeftInactive}" Width="24" Height="24"/>
					<Button Content="{StaticResource ArrowBlueRightInactive}" Width="24" Height="24"/>
				</ToolBar>
				<ToolBar>
					<Button Content="{StaticResource ArrowBlueLeftActive}" Width="24" Height="24"/>
					<Button Content="{StaticResource ArrowBlueRightActive}" Width="24" Height="24"/>
				</ToolBar>
				<ToolBar>
					<Button Width="70" Click="OnAddRootDocking">Add Root</Button>
					<Label Width="5"></Label>
					<ComboBox Name="_cmbRootDirection" Width="80" SelectedValuePath="Content">
						<ComboBoxItem IsSelected="True">Top</ComboBoxItem>
						<ComboBoxItem>Left</ComboBoxItem>
						<ComboBoxItem>Right</ComboBoxItem>
						<ComboBoxItem>Bottom</ComboBoxItem>
						<ComboBoxItem>Center</ComboBoxItem>
						<ComboBoxItem>Floating</ComboBoxItem>
					</ComboBox>
				</ToolBar>
			</ToolBarTray>
		</StackPanel>

		<DMNS:DockingPanel Grid.Row="1" Name="RootDockPanel">
			<DMNS:DockingGroup TabPosition="Bottom" DockAnchor="PropertyGroup">
				<Button DMNS:DockingPanel.DockTitle="Testbutton1">Testbutton1</Button>
				<Button DMNS:DockingPanel.DockTitle="Testbutton2">Testbutton2</Button>
				<Button DMNS:DockingPanel.DockTitle="Testbutton3">Testbutton3</Button>
			</DMNS:DockingGroup>
			<DMNS:DockingGroup TabPosition="Bottom" DockTarget="PropertyGroup" DockPosition="Left">
				<Button DMNS:DockingPanel.DockTitle="Testbutton4">Testbutton4</Button>
				<Button DMNS:DockingPanel.DockTitle="Testbutton5">Testbutton5</Button>
				<Button DMNS:DockingPanel.DockTitle="Testbutton6">Testbutton6</Button>
			</DMNS:DockingGroup>
			<!-- The first element doesn't need a dock position because the window is empty anyway and there is nothing we can dock to.
				If it is provided it is ignored.
				DockTitle is the title that should appear on the tab item header.
				DockAnchor: All items with the same name will be added to the same TabControl.
					If no DockAnchor is specified the item is added to the root. The anchor is
					optional and only required if the item is to be targeted by another one.
				DockLength: Accepts values from GridLength i.E. "1.0,*", "Auto", "100", etc.
			-->
			<!--
			<uc:TestControl
				DMNS:DockingPanel.DockLength="100"
				DMNS:DockingPanel.DockAnchor="BrowserGroup"
				DMNS:DockingPanel.DockTitle="TabText1"
				></uc:TestControl>
			<uc:TestControl
				DMNS:DockingPanel.DockTarget="BrowserGroup"
				DMNS:DockingPanel.DockTitle="TabText2"
				DMNS:DockingPanel.Dock="Right"></uc:TestControl>
            <uc:TestControl
				DMNS:DockingPanel.DockLength="500"
				DMNS:DockingPanel.DockTarget="BrowserGroup"
				DMNS:DockingPanel.DockTitle="TabText3"
				DMNS:DockingPanel.Dock="Right"></uc:TestControl>
			<uc:TestControl
				DMNS:DockingPanel.DockTarget="BrowserGroup"
				DMNS:DockingPanel.DockTitle="TabText4"
				DMNS:DockingPanel.Dock="Right"></uc:TestControl>
			<uc:TestControl
				DMNS:DockingPanel.DockTarget="BrowserGroup"
				DMNS:DockingPanel.Dock="Bottom"
				DMNS:DockingPanel.DockTitle="SecondLeftButton3"></uc:TestControl>

			<uc:TestControl
				DMNS:DockingPanel.DockTarget="BrowserGroup"
				DMNS:DockingPanel.DockTitle="AdditionalTab"></uc:TestControl>
			-->
			<!-- No target specified, so it is at the DockingPanel border -->
			<!--
			<uc:TestControl
				DMNS:DockingPanel.DockLength="70"
				DMNS:DockingPanel.Dock="Bottom"
				DMNS:DockingPanel.DockTitle="SecondLeftButton3"></uc:TestControl>
			-->

			<!--
			<uc:TestControl
				DMNS:DockingPanel.FloatingRectangle="1000,10,200,100"
				DMNS:DockingPanel.DockFloating="Vertical"
				DMNS:DockingPanel.DockTitle="Floating"></uc:TestControl>
			-->
		</DMNS:DockingPanel>

		<!-- <Custom:FileTreeControl Grid.Row="1" Grid.Column="0"/> -->

		<!-- Status Bar -->
		<TextBox AcceptsReturn="True" Grid.Row="2" Text="Statusbar"/>
	</Grid>
</Window>
