<Window x:Class="SwampDbg.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:SwampDbg"
	mc:Ignorable="d"
	Title="SwampDbg" Height="450" Width="800">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0">
			<Menu Name="mnMainMenu" DockPanel.Dock="Top">
				<MenuItem Header="_File">
					<MenuItem Header="_Open">
						<MenuItem Header="_File"/>
						<MenuItem Header="_Project"/>
					</MenuItem>
					<Separator />
					<MenuItem Header="_Exit" />
				</MenuItem>
				<MenuItem Header="_Tools">
					<MenuItem Header="_Configure1" />
					<MenuItem Header="_Configure2" />
				</MenuItem>
				<MenuItem Header="_Plugins">
					<MenuItem Header="_Configure" />
					<MenuItem Header="_Unload" />
				</MenuItem>
				<MenuItem Header="_Help">
					<MenuItem Header="_About" />
				</MenuItem>
			</Menu>
			<ToolBarTray DockPanel.Dock="Top">
				<ToolBar>
					<Button Command="New" Content="New" />
					<Button Command="Open" Content="Open" />
					<Button Command="Save" Content="Save" />
				</ToolBar>
				<ToolBar>
					<Button Command="Cut" Content="Cut" />
					<Button Command="Copy" Content="Copy" />
					<Button Command="Paste" Content="Paste" />
				</ToolBar>
			</ToolBarTray>
		</StackPanel>

		<!-- Status Bar -->
		<TextBox AcceptsReturn="True" Grid.Row="2" Text="Statusbar"/>
	</Grid>
</Window>
