<Application x:Class="SwampDbg.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:SwampDbg"
	xmlns:Custom="clr-namespace:SwampDbg"
	DispatcherUnhandledException="ApplicationUnhandledException"
	Startup="ApplicationStartup">

	<Application.Resources>
		<Image x:Key="ArrowBlueLeftActive" Source="/SwampDbg;component/Images/Icons/ArrowBlueLeftActive.png" />
		<Image x:Key="ArrowBlueLeftInactive" Source="/SwampDbg;component/Images/Icons/ArrowBlueLeftInactive.png" />
		<Image x:Key="ArrowBlueRightActive" Source="/SwampDbg;component/Images/Icons/ArrowBlueRightActive.png" />
		<Image x:Key="ArrowBlueRightInactive" Source="/SwampDbg;component/Images/Icons/ArrowBlueRightInactive.png" />
		<Image x:Key="Browse" Source="/SwampDbg;component/Images/Icons/Browse.png" />
		<Image x:Key="File" Source="/SwampDbg;component/Images/Icons/File.png" />
		<Image x:Key="Folder" Source="/SwampDbg;component/Images/Icons/Folder.png" />
		<Image x:Key="Refresh" Source="/SwampDbg;component/Images/Icons/Refresh.png" />
		<Image x:Key="Lock" Source="/SwampDbg;component/Images/Icons/Lock.png" />
		<Image x:Key="Unlock" Source="/SwampDbg;component/Images/Icons/Unlock.png" />
	</Application.Resources>
</Application>
