<Application x:Class="SwampDbg.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:SwampDbg"
	DispatcherUnhandledException="ApplicationUnhandledException"
	Startup="ApplicationStartup">

	<Application.Resources>
		<Image x:Key="ArrowBlueLeftActive" Source="/SwampDbg;component/Images/Icons/ArrowBlueLeftActive.png" />
		<Image x:Key="ArrowBlueLeftInactive" Source="/SwampDbg;component/Images/Icons/ArrowBlueLeftInactive.png" />
		<Image x:Key="ArrowBlueRightActive" Source="/SwampDbg;component/Images/Icons/ArrowBlueRightActive.png" />
		<Image x:Key="ArrowBlueRightInactive" Source="/SwampDbg;component/Images/Icons/ArrowBlueRightInactive.png" />
	</Application.Resources>
</Application>
