<Grid x:Class="WpfDockingManager.DockingGroup"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:local="clr-namespace:WpfDockingManager"
			 x:Name="dockingGroupControl"
			 mc:Ignorable="d" 
			 d:DesignHeight="450" d:DesignWidth="800">

	<Grid.Resources>
		<local:TabItemRotation x:Key="TabItemRotation"/>
	</Grid.Resources>

	<local:DragTabControl x:Name="_tabControl" TabStripPlacement="{Binding ElementName=dockingGroupControl, Path=TabStripPlacement}" ItemClose="OnItemClose">
	</local:DragTabControl>

</Grid>
