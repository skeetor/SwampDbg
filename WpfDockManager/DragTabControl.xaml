	<TabControl.ItemContainerStyle>
		<Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
			<Style.Triggers>
				<!-- Depending on the orientation, we have to place the close button in the correct place.
					This means, we have to use rows or columns and put the button after the text. This
					can not be done in a nice way as the grid can not conditionally create columns OR rows
					so we have to duplicate the style with the different setups. We can at least reduce it
					to a single duplicate, using converters to place the button in the correct spot.
				-->
				<DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=TabStripPlacement, Converter={StaticResource ResourceKey=DockOrientationConverter}}" Value="Horizontal">
					<Setter Property="Height" Value="{Binding TabHeight, RelativeSource={RelativeSource AncestorType={x:Type local:DockingGroup}}}"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="TabItem">
								<Grid>
									<Border x:Name="Border" 
											Background="{TemplateBinding Background}"
											BorderThickness="{TemplateBinding BorderThickness}"
											BorderBrush="{TemplateBinding BorderBrush}"
											CornerRadius="2"
											Margin="2,2,2,0">
										<Grid Name="_btnGrid">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<ContentPresenter x:Name="ContentSite"
																Grid.Column="0"
																VerticalAlignment="Center"
																HorizontalAlignment="Center"
																ContentSource="Header"
																RecognizesAccessKey="True"
																Margin="5,2,5,2"/>

											<Button x:Name="CloseButton"
														Grid.Column="1"
														Style="{StaticResource CloseButtonStyle}"
														Margin="5,0,5,0"
														Command="{Binding CloseTabCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DockingGroup}}}"
														CommandParameter="{Binding}"/>
										</Grid>
									</Border>
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsSelected" Value="True">
										<Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
										<Setter TargetName="Border" Property="BorderBrush" Value="DarkGray"/>
									</Trigger>
									<Trigger Property="IsSelected" Value="False">
										<Setter TargetName="Border" Property="Background" Value="LightGray"/>
										<Setter TargetName="Border" Property="BorderBrush" Value="Gray"/>
									</Trigger>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="Border" Property="Background" Value="#FFDDDDDD"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</DataTrigger>
				<DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=TabStripPlacement, Converter={StaticResource ResourceKey=DockOrientationConverter}}" Value="Vertical">
					<Setter Property="Width" Value="{Binding TabHeight, RelativeSource={RelativeSource AncestorType={x:Type local:DockingGroup}}}"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="TabItem">
								<Grid>
									<Border x:Name="Border" 
											Background="{TemplateBinding Background}"
											BorderThickness="{TemplateBinding BorderThickness}"
											BorderBrush="{TemplateBinding BorderBrush}"
											CornerRadius="2"
											Margin="2,2,2,0">
										<Grid Name="_btnGrid">
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="*"/>
											</Grid.RowDefinitions>

											<ContentPresenter x:Name="ContentSite"
																Grid.Row="{Binding
																	RelativeSource={RelativeSource TemplatedParent},
																	Path=TabStripPlacement,
																	Converter={StaticResource ResourceKey=GridRowAdjustment},
																	ConverterParameter=content}"
																VerticalAlignment="Center"
																HorizontalAlignment="Center"
																ContentSource="Header"
																RecognizesAccessKey="True"
																Margin="5,2,5,2"/>

											<Button x:Name="CloseButton"
														Grid.Row="{Binding
															RelativeSource={RelativeSource TemplatedParent},
															Path=TabStripPlacement,
															Converter={StaticResource ResourceKey=GridRowAdjustment},
															ConverterParameter=button}"
														Style="{StaticResource CloseButtonStyle}"
														Margin="5,0,5,0"
														Command="{Binding CloseTabCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DockingGroup}}}"
														CommandParameter="{Binding}"/>
										</Grid>
									</Border>
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsSelected" Value="True">
										<Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
										<Setter TargetName="Border" Property="BorderBrush" Value="DarkGray"/>
									</Trigger>
									<Trigger Property="IsSelected" Value="False">
										<Setter TargetName="Border" Property="Background" Value="LightGray"/>
										<Setter TargetName="Border" Property="BorderBrush" Value="Gray"/>
									</Trigger>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="Border" Property="Background" Value="#FFDDDDDD"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</DataTrigger>
			</Style.Triggers>
			<Setter Property="Width" Value="{Binding TabWidth, RelativeSource={RelativeSource AncestorType={x:Type local:DockingGroup}}}"/>
		</Style>
	</TabControl.ItemContainerStyle>
</TabControl>
